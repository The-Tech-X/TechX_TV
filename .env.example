# ────────────────────────────────────────────────────────────────────────────
# The TechX Studio — environment variables
# Copy to .env (locally) or set in your hosting platform's dashboard.
# .env is gitignored — never commit real secrets.
# ────────────────────────────────────────────────────────────────────────────

# Supabase — project URL + service role key from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM — free tier at https://build.nvidia.com
# Powers script generation (Llama 3 / Sarvam-M) and per-topic analysis (Mistral Large 3).
NVIDIA_API_KEY=

# Firecrawl — web search for the analytics step. Monthly-quota plans: https://firecrawl.dev
FIRECRAWL_API_KEY=

# Gemini — generates LinkedIn/WhatsApp/X posts directly from the scraped
# sources (fast path, skips the NIM/Mistral brief). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Upstash QStash. Only set this if deploying to a serverless platform
# with short function timeouts (e.g. Vercel Hobby). On Render / Fly / VPS the
# app runs the NVIDIA call inline as fire-and-forget — leave this empty.
QSTASH_TOKEN=

# Login — the whole app sits behind a single-account login (see middleware.ts).
# AUTH_PASSWORD_HASH_B64 is a bcrypt hash, base64-encoded. Encoding matters:
# Next.js's .env loader does $VAR-style expansion even inside quotes, which
# silently mangles a raw bcrypt hash (they always contain "$2b$12$...").
# Generate a hash + secret with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('yourpassword', 12)).toString('base64'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_EMAIL=
AUTH_PASSWORD_HASH_B64=
AUTH_SECRET=
